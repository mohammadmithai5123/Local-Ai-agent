# Copy to .env and edit locally. Never paste keys into chat.
GEMINI_API_KEY=
# Confirm in AI Studio that this project has NO billing enabled.
FREE_TIER_CONFIRMED=false
# Also consent to sending selected lead fields to Gemini's free tier.
AI_DATA_CONSENT=false
GEMINI_MODEL=gemini-3.8-flash
# Optional: outgoing draft subject/body language, independent of chat instruction language.
OUTREACH_LANGUAGE=english
PORT=3000
# Google OAuth Web application credentials, edited locally only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional registered redirect URI. Leave empty to use localhost:PORT/api/gmail/callback.
GOOGLE_REDIRECT_URI=
# Must match the Google account you authorize, or its verified send-as alias.
GMAIL_SENDER_EMAIL=
# Keep false until you deliberately enable real sending after account setup.
GMAIL_ENABLE_SENDING=false
# Public discovery: Tavily Researcher FREE plan only, no card/paid overages.
# Verify plan privately at https://app.tavily.com ; never paste the key into chat.
TAVILY_API_KEY=
SEARCH_FREE_TIER_CONFIRMED=false
# Consent to sending search country/category to Tavily and retrieved excerpts to Gemini.
SEARCH_DATA_CONSENT=false
